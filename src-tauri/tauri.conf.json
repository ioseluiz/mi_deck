{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MiDeck",
  "version": "0.1.2",
  "identifier": "com.pancanal.mideck",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MiDeck",
        "width": 596,
        "height": 509,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "dragDropEnabled": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "publisher": "ioseluiz",
    "copyright": "Copyright (c) 2026 ioseluiz",
    "category": "Utility",
    "homepage": "https://github.com/ioseluiz/mi_deck",
    "shortDescription": "Widget de escritorio tipo Stream Deck",
    "longDescription": "Panel flotante de teclas que abren aplicaciones, sitios web, carpetas y scripts con un clic. Carpetas anidadas, imagenes propias por tecla e iconos extraidos de los ejecutables. Funciona en local, sin red.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}
